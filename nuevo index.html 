<style>
/* Plan: deporte con tecnología, en claro. Blanco y gris frío como base, rojo GoFit58 como protagonista.
   El pote negro vive sobre rojo para que resalte; el carbón queda solo en la cinta y el pie.
   Jugada fuerte: hero rojo con visor HUD, cifras grandes y calculadora de pedido. */
:root{
  --paper:#FFFFFF; --soft:#F2F3F7; --ink:#14151A; --mute:#565965; --line:#E0E2E9;
  --red:#D41F33; --red-2:#E8283D; --red-deep:#A31020; --dark:#16171C;
  --disp:'Barlow Condensed','Arial Narrow',Arial,sans-serif;
  --body:'Barlow',Arial,sans-serif;
  --mono:'JetBrains Mono',ui-monospace,Menlo,Consolas,monospace;
}
*{box-sizing:border-box}
[hidden]{display:none!important}
html{color-scheme:light;scroll-behavior:smooth;background:var(--paper)}
body{margin:0;background:var(--paper);color:var(--ink);font:400 1.0625rem/1.6 var(--body);-webkit-font-smoothing:antialiased}
img,svg{max-width:100%}
a{color:inherit}
:focus-visible{outline:3px solid var(--ink);outline-offset:3px}
.wrap{width:100%;max-width:1180px;margin:0 auto;padding:0 20px}
.eyebrow{font-family:var(--mono);font-size:.8125rem;letter-spacing:.14em;text-transform:uppercase;color:var(--red);font-weight:600;margin:0 0 14px}
h1,h2,h3{font-family:var(--disp);font-style:italic;font-weight:800;text-transform:uppercase;margin:0;text-wrap:balance}
h2{font-size:clamp(2.3rem,5.6vw,4.1rem);line-height:.95;letter-spacing:.01em}
h3{font-size:1.65rem;font-weight:700;line-height:1}
p{margin:0}
.muted{color:var(--mute)}

/* barra superior */
.top{position:sticky;top:0;z-index:20;background:rgba(255,255,255,.94);-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
.top .wrap{display:flex;align-items:center;gap:12px;height:68px}
.gf{display:block;width:46px;height:46px;border-radius:50%}
.cross{color:var(--mute);font-family:var(--mono)}
.nx-logo{height:30px;width:auto;display:block;color:var(--ink)}
.top-cta{margin-left:auto;display:inline-flex;align-items:center;min-height:44px;white-space:nowrap;font:700 .95rem/1 var(--disp);letter-spacing:.1em;text-transform:uppercase;text-decoration:none;background:var(--red);color:#fff;padding:.85rem 1.1rem}
.top-cta:hover{background:var(--red-deep)}

/* botones */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:.6rem;font:700 1.1rem/1 var(--disp);letter-spacing:.08em;text-transform:uppercase;text-decoration:none;padding:1.1rem 1.8rem;cursor:pointer;border:0;color:#fff;background:var(--red);clip-path:polygon(14px 0,100% 0,calc(100% - 14px) 100%,0 100%)}
.btn:hover{background:var(--red-deep)}
.btn.white{background:#fff;color:var(--red)}
.btn.white:hover{background:var(--soft)}
.btn.line{background:transparent;color:#fff;clip-path:none;border:2px solid rgba(255,255,255,.75);padding:1rem 1.6rem}
.btn.line:hover{background:rgba(255,255,255,.14)}
.btn svg{width:20px;height:20px;fill:currentColor}

/* hero */
.hero{position:relative;overflow:hidden;color:#fff;background:linear-gradient(135deg,#DB2237 0%,#C41A2D 55%,#9E0F1E 100%);padding:52px 0 120px;clip-path:polygon(0 0,100% 0,100% calc(100% - 44px),0 100%)}
.hero::before{content:"";position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.12) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.12) 1px,transparent 1px);background-size:56px 56px;-webkit-mask-image:radial-gradient(ellipse 85% 80% at 72% 45%,#000 15%,transparent 78%);mask-image:radial-gradient(ellipse 85% 80% at 72% 45%,#000 15%,transparent 78%)}
.hero::after{content:"";position:absolute;right:-8%;top:-30%;width:46%;height:160%;background:rgba(255,255,255,.07);transform:skewX(-18deg)}
.hero .wrap{position:relative;z-index:1;display:grid;grid-template-columns:minmax(0,1fr);gap:0;align-items:center}
.hero .wrap>div:first-child{display:contents}
.pills{order:1}.hero .eyebrow{order:2}h1{order:3}.hero .stage{order:4}.lead{order:5}.cta-row{order:6}.perks{order:7}
.pills{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 22px}
.pill{font-family:var(--mono);font-size:.75rem;letter-spacing:.12em;text-transform:uppercase;border:1px solid rgba(255,255,255,.6);padding:.4rem .7rem;font-weight:600}
.hero .eyebrow{color:#fff;opacity:.92}
h1{font-size:clamp(3rem,11.5vw,6.75rem);line-height:.86;letter-spacing:.005em;min-width:0}
h1 .l2{display:block;font-size:.82em;color:var(--dark)}
.lead{max-width:34rem;margin:16px 0 26px;font-size:1.22rem;color:#fff}
.cta-row{display:flex;flex-wrap:wrap;gap:14px;align-items:center}
.perks{display:flex;flex-wrap:wrap;gap:8px 22px;margin-top:26px;font-family:var(--mono);font-size:.78rem;letter-spacing:.1em;text-transform:uppercase;font-weight:600}
.perks span::before{content:"✓";margin-right:.5em;color:var(--dark);font-weight:700}

.stage{position:relative;justify-self:center;width:min(80%,310px);margin:20px 0 4px;padding:30px 22px 22px}
.stage::before{content:"";position:absolute;left:50%;top:50%;width:112%;aspect-ratio:1;transform:translate(-50%,-50%);border-radius:50%;background:radial-gradient(closest-side,rgba(255,255,255,.55),rgba(255,255,255,.12) 62%,rgba(255,255,255,0) 72%)}
.stage img{position:relative;z-index:1;display:block;width:100%;height:auto;filter:drop-shadow(0 28px 26px rgba(70,0,10,.55))}
.corner{position:absolute;width:24px;height:24px;border:3px solid #fff;z-index:2}
.corner.tl{left:0;top:0;border-right:0;border-bottom:0}
.corner.tr{right:0;top:0;border-left:0;border-bottom:0}
.corner.bl{left:0;bottom:0;border-right:0;border-top:0}
.corner.br{right:0;bottom:0;border-left:0;border-top:0}
.tag{position:absolute;z-index:3;font-family:var(--mono);font-size:.72rem;letter-spacing:.1em;text-transform:uppercase;font-weight:600;background:#fff;color:var(--ink);padding:.35rem .6rem}
.tag i{color:var(--red);font-style:normal}
.tag.a{left:12px;top:10px}
.tag.b{right:12px;bottom:10px}
.scan{position:absolute;left:0;right:0;height:2px;z-index:2;background:linear-gradient(90deg,transparent,#fff,transparent);opacity:.85;animation:scan 4.5s ease-in-out infinite}
@keyframes scan{0%{top:6%}50%{top:94%}100%{top:6%}}

/* cifras */
.metrics{position:relative;z-index:3;margin-top:-64px}
.metrics .grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0;background:#fff;border:1px solid var(--line);box-shadow:0 24px 50px -24px rgba(20,21,26,.35)}
.m{padding:24px 20px;border-right:1px solid var(--line);border-bottom:1px solid var(--line)}
.m b{display:block;font:800 clamp(2.6rem,8vw,3.6rem)/.9 var(--disp);font-style:italic;color:var(--red)}
.m span{display:block;margin-top:8px;font-family:var(--mono);font-size:.72rem;letter-spacing:.12em;text-transform:uppercase;color:var(--mute)}

/* cinta */
.ticker{overflow:hidden;background:var(--dark);color:#fff;transform:skewY(-1.2deg);margin:70px 0 0;position:relative;z-index:2}
.ticker div{display:flex;width:max-content;animation:run 26s linear infinite}
.ticker span{font:800 1.5rem/1 var(--disp);font-style:italic;letter-spacing:.08em;text-transform:uppercase;padding:.85rem 1.4rem;white-space:nowrap}
.ticker span::after{content:"/";margin-left:2.8rem;color:var(--red-2)}
@keyframes run{to{transform:translateX(-50%)}}

section.s{padding:88px 0}
section[id]{scroll-margin-top:76px}
section.s.soft{background:var(--soft)}
.head{max-width:44rem;margin-bottom:40px}
.head p{margin-top:16px;color:var(--mute);font-size:1.15rem}

/* función */

/* tarjetas */
.cards{display:grid;gap:18px;grid-template-columns:repeat(auto-fit,minmax(240px,1fr))}
.card{position:relative;padding:26px 24px 28px;background:#fff;border:1px solid var(--line);border-top:5px solid var(--red);box-shadow:0 14px 30px -22px rgba(20,21,26,.4)}
.card .n{font-family:var(--mono);font-size:.75rem;letter-spacing:.14em;color:var(--mute);font-weight:600}
.card svg{display:block;width:40px;height:40px;margin:16px 0 14px;stroke:var(--red);fill:none;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
.card p{margin-top:10px;color:var(--mute)}
.cards.b4{grid-template-columns:minmax(0,1fr)}
.ref{margin-top:22px;font-family:var(--mono);font-size:.72rem;letter-spacing:.08em;color:var(--mute)}

/* ficha */
.spec{display:grid;grid-template-columns:minmax(0,1fr);gap:30px;align-items:start}
dl.rows{margin:0;border-top:3px solid var(--ink)}
dl.rows div{display:grid;grid-template-columns:minmax(120px,.8fr) 1.4fr;gap:14px;padding:16px 0;border-bottom:1px solid var(--line)}
dl.rows dt{font-family:var(--mono);font-size:.78rem;letter-spacing:.12em;text-transform:uppercase;color:var(--mute);font-weight:600}
dl.rows dd{margin:0;font-weight:500}
.days{padding:32px 28px;background:var(--dark);color:#fff;clip-path:polygon(0 0,calc(100% - 28px) 0,100% 28px,100% 100%,0 100%)}
.days b{display:block;font:800 clamp(5rem,16vw,8.5rem)/.85 var(--disp);font-style:italic;color:#FF5468}
.days p{font:700 1.55rem/1.1 var(--disp);font-style:italic;text-transform:uppercase;margin-top:10px}
.days small{display:block;margin-top:14px;font-family:var(--mono);font-size:.72rem;letter-spacing:.1em;text-transform:uppercase;color:#C9CBD3}
.warn{margin-top:22px;font-size:.92rem;color:var(--mute)}

/* mostrador */
.faq{display:grid;gap:12px;max-width:52rem}
.faq details{background:#fff;border:1px solid var(--line);border-left:5px solid var(--red)}
.faq summary{cursor:pointer;list-style:none;padding:20px 22px;font:700 1.45rem/1.1 var(--disp);font-style:italic;text-transform:uppercase;display:flex;justify-content:space-between;gap:16px;align-items:center}
.faq summary::-webkit-details-marker{display:none}
.faq summary::after{content:"+";font:600 1.6rem/1 var(--mono);color:var(--red);flex:none}
.faq details[open] summary::after{content:"−"}
.faq details p{padding:0 22px 22px;color:var(--mute)}

/* pedido */
.order-s{background:linear-gradient(135deg,#DB2237 0%,#B5121F 100%);color:#fff;position:relative;overflow:hidden}
.order-s::before{content:"";position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.1) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.1) 1px,transparent 1px);background-size:56px 56px;-webkit-mask-image:radial-gradient(ellipse 70% 80% at 25% 40%,#000 10%,transparent 75%);mask-image:radial-gradient(ellipse 70% 80% at 25% 40%,#000 10%,transparent 75%)}
.order{position:relative;display:grid;grid-template-columns:minmax(0,1fr);gap:28px}
.order .eyebrow{color:#fff}
.bigq{font:800 clamp(7rem,24vw,14rem)/.8 var(--disp);font-style:italic;color:#fff;letter-spacing:-.01em}
.order .sub{margin-top:16px;max-width:26rem;color:#fff}
.ptable{margin-top:24px;max-width:32rem;background:#fff;color:var(--ink);box-shadow:0 24px 40px -26px rgba(60,0,8,.7)}
.ptable .row{display:grid;grid-template-columns:1.15fr 1fr 1fr;align-items:center;border-bottom:1px solid var(--line)}
.ptable .row:last-child{border-bottom:0}
.ptable .row>*{padding:14px 12px;min-width:0}
.ptable .row.h{background:var(--dark);color:#fff}
.ptable .row.h span{font-family:var(--mono);font-size:.72rem;letter-spacing:.1em;text-transform:uppercase;font-weight:600;line-height:1.35}
.ptable .row.h span:first-child{color:#C9CBD3}
.ptable .q b{display:block;font:800 1.45rem/1 var(--disp);font-style:italic;text-transform:uppercase}
.ptable .q small{display:block;margin-top:4px;font-family:var(--mono);font-size:.72rem;letter-spacing:.08em;text-transform:uppercase;color:var(--mute)}
.ptable .p{font:800 1.9rem/1 var(--disp);font-style:italic;white-space:nowrap}
.ptable .p small{font:600 .72rem/1 var(--mono);font-style:normal;letter-spacing:.06em;color:var(--mute);margin-left:4px}
.ptable .row.best{background:#FFF1F2}
.ptable .row.best .q small{color:var(--red);font-weight:600}
.ptnote{max-width:32rem;margin-top:10px;font-size:.88rem;color:#fff;line-height:1.45}
.rate{width:100%;max-width:260px;font:600 1.1rem/1 var(--mono);padding:.85rem .9rem;border:2px solid var(--line);background:#fff;color:var(--ink)}
.rate:focus-visible{border-color:var(--red)}
.pay{display:flex;flex-wrap:wrap;gap:8px}
.pay button{font:700 1.05rem/1.1 var(--disp);letter-spacing:.06em;text-transform:uppercase;color:var(--ink);background:#fff;border:2px solid var(--line);padding:.75rem 1rem;cursor:pointer;text-align:left}
.pay button small{display:block;margin-top:3px;font:600 .72rem/1.2 var(--mono);letter-spacing:.08em;color:var(--mute)}
.pay button[aria-pressed="true"]{background:var(--red);border-color:var(--red);color:#fff}
.pay button[aria-pressed="true"] small{color:#fff}
.calc{background:#fff;color:var(--ink);padding:26px 22px;display:grid;grid-template-columns:minmax(0,1fr);gap:24px;box-shadow:0 30px 60px -28px rgba(60,0,8,.7)}
.ctl{display:grid;gap:22px;grid-template-columns:minmax(0,1fr);align-content:start}
.ctl h3{font:600 .8rem/1.2 var(--mono);font-style:normal;letter-spacing:.14em;color:var(--mute);margin-bottom:10px}
.seg{display:flex;flex-wrap:wrap;gap:8px}
.seg button{font:800 1.5rem/1 var(--disp);font-style:italic;color:var(--ink);background:#fff;border:2px solid var(--line);padding:.7rem 1.2rem;cursor:pointer}
.seg button[aria-pressed="true"]{background:var(--red);border-color:var(--red);color:#fff}
.seg button small{display:block;font:600 .72rem/1.2 var(--mono);letter-spacing:.1em;text-transform:uppercase;font-style:normal;margin-top:4px}
.res{display:grid;gap:12px;grid-template-columns:1fr 1fr}
.tile{background:var(--soft);padding:16px 16px 14px}
.tile span{display:block;font-family:var(--mono);font-size:.72rem;letter-spacing:.12em;text-transform:uppercase;color:var(--mute);font-weight:600}
.tile b{display:block;margin-top:8px;font:800 clamp(1.7rem,6vw,2.6rem)/1 var(--disp);font-style:italic;font-variant-numeric:tabular-nums;white-space:nowrap}
.tile small{display:block;margin-top:6px;font-size:.85rem;color:var(--mute)}
.tile.gain{grid-column:1/-1;background:var(--red);color:#fff}
.tile.gain span,.tile.gain small{color:#fff}
.tile.gain b{font-size:clamp(2.6rem,9vw,4rem)}
.sum{grid-column:1/-1;display:grid;gap:12px}
.sum .row{display:flex;flex-wrap:wrap;align-items:center;gap:12px}
.sum .btn.alt{background:var(--ink)}
.sum .btn.alt:hover{background:#000}
.sum textarea{width:100%;min-height:96px;overflow:hidden;resize:none;background:var(--soft);color:var(--ink);border:1px dashed #b9bcc7;padding:12px;font:400 .85rem/1.5 var(--mono)}
.msg{font-family:var(--mono);font-size:.75rem;color:var(--red);letter-spacing:.06em;font-weight:600}
.note{font-size:.88rem;color:var(--mute)}

/* pasos */
.steps{display:grid;gap:18px;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));counter-reset:st}
.steps .card{border-top-color:var(--dark)}
.steps .card::before{counter-increment:st;content:"0" counter(st);display:block;font:800 3rem/1 var(--disp);font-style:italic;color:var(--red);margin-bottom:10px}

/* contacto */
.cta-band{background:var(--dark);color:#fff;padding:36px 24px;display:grid;gap:22px;grid-template-columns:minmax(0,1fr);align-items:center}
.cta-band h2{font-size:clamp(2.2rem,5vw,3.6rem)}
.cta-band p{color:#D2D4DB;margin-top:10px}
.contact{display:grid;gap:14px;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));margin-top:22px}
.contact a,.contact div{display:block;text-decoration:none;background:#fff;border:1px solid var(--line);padding:20px;border-left:5px solid var(--red)}
.contact a:hover{box-shadow:0 14px 30px -20px rgba(20,21,26,.5)}
.contact span{display:block;font-family:var(--mono);font-size:.72rem;letter-spacing:.12em;text-transform:uppercase;color:var(--mute);margin-bottom:8px;font-weight:600}
.contact b{font:800 1.6rem/1.1 var(--disp);font-style:italic;text-transform:uppercase;overflow-wrap:anywhere}
.contact b.lc{text-transform:none}
footer{background:var(--dark);color:#fff;padding:44px 0 56px}
footer .wrap{display:flex;flex-wrap:wrap;gap:20px 36px;align-items:center}
footer .nx-logo{color:#fff;height:34px}
footer .gf{width:56px;height:56px}
footer p{flex:1 1 320px;max-width:46rem;font-size:.82rem;color:#B9BBC4;line-height:1.55}

.wa-float{position:fixed;left:12px;right:12px;bottom:calc(12px + env(safe-area-inset-bottom));z-index:30;display:none;opacity:0;transform:translateY(24px);pointer-events:none;visibility:hidden;transition:opacity .25s ease,transform .25s ease,visibility 0s linear .25s}
.wa-float.show{opacity:1;transform:none;pointer-events:auto;visibility:visible;transition:opacity .25s ease,transform .25s ease,visibility 0s}
.wa-float .btn{width:100%;clip-path:none;padding:1rem;box-shadow:0 12px 30px -8px rgba(60,0,8,.7)}

@media (min-width:600px){
  .cards.b4{grid-template-columns:repeat(2,minmax(0,1fr))}
}
@media (min-width:700px){
  .stage{width:min(72%,420px)}
  .metrics .grid{grid-template-columns:repeat(4,minmax(0,1fr))}
  .m{border-bottom:0}
  .m:last-child{border-right:0}
}
@media (max-width:699px){
  .m:nth-child(2n){border-right:0}
  .m:nth-child(n+3){border-bottom:0}
  .wa-float{display:block}
  body{padding-bottom:84px}
  .top-cta{padding:.8rem .9rem;font-size:.85rem}
}
@media (min-width:900px){
  .hero{padding:76px 0 140px}
  .hero .wrap{grid-template-columns:minmax(0,1.15fr) minmax(0,.85fr);gap:56px}
  .hero .wrap>div:first-child{display:block}
  .stage{width:min(100%,440px);margin:0;padding:34px 28px 28px}
  .spec{grid-template-columns:minmax(0,1.3fr) minmax(0,.7fr);gap:56px}
  .cards.b4{grid-template-columns:repeat(4,minmax(0,1fr))}
  .order{grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);gap:56px;align-items:start}
  .calc{padding:34px 30px}
  .cta-band{grid-template-columns:minmax(0,1fr) auto;padding:44px 40px}
}
html.rv-on .rv{opacity:0;transform:translateY(14px);transition:opacity .45s ease,transform .45s ease}
html.rv-on .rv.in{opacity:1;transform:none}
@media (prefers-reduced-motion:reduce){.ticker div{animation:none}.scan{animation:none;display:none}html{scroll-behavior:auto}}
